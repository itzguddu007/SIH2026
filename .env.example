# Server port (automatically provided by Render, optional locally)
PORT=3000

# Twilio Credentials (Required for SMS/WhatsApp alert dispatch)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Sender WhatsApp number (e.g., whatsapp:+14155238886 for Twilio sandbox)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Destination phone number (with country code, e.g. whatsapp:+919876543210)
ALERT_TO_NUMBER=whatsapp:+91XXXXXXXXXX
